# After git clone / git pull:
# 1) Copy this to .env  OR paste a real .env from the configured machine
# 2) Run setup.bat from project root
# 3) START_BACKEND.bat then START_FRONTEND.bat
# 4) Open http://localhost:3000 and Register / Login

PORT=5000
JWT_SECRET=mysecretkey123
FRONTEND_URL=http://localhost:3000

# SQLite = no MySQL install needed for local demo
FORCE_SQLITE=1
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=college_db

# Paste REAL values from a configured backend/.env (USB / private copy)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
