# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# After Google OAuth, user is redirected here (MUST be your Vercel URL in production)
# Example: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Database — on Render use a real MySQL/Postgres host, NOT localhost
# localhost on Render falls back to SQLite and WIPES data on every restart
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=college_db
# DB_PORT=3306

# Google / Gmail OAuth 2.0 — redirect URI must EXACTLY match Google Cloud Console
# Local:  http://localhost:5000/api/auth/google/callback
# Prod:   https://gmail-assistant-1.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
