# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

FRONTEND_URL=https://gmail-assistant-roan.vercel.app

# --- Database: SQLite for now (free, zero setup) ---
# On Render with localhost (or FORCE_SQLITE=1) the app uses backend/college.db
# Note: Render free tier can wipe this file on restart → re-login Google + re-link Telegram
FORCE_SQLITE=1
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=college_db

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://gmail-assistant-1.onrender.com/api/auth/google/callback

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key_here
